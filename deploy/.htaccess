# ==============================================================================
# SAILL Production Apache / Hostinger Configuration
# Place this in your Hostinger public_html directory if deploying via Apache / LiteSpeed
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Reverse proxy /api calls to local Node.js process (Port 3000)
  # Uncomment the following line if using Apache mod_proxy with Node backend:
  # RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]

  # 2. Allow existing static files & directories (assets, audio, scripts)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Route all SPA page requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Security and caching headers for static production assets
  <FilesMatch "\.(css|js|woff2|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
